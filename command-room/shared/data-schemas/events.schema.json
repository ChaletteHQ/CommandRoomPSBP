{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-room://schemas/events.schema.json",
  "title": "Event",
  "description": "Single event record. events.jsonl is a newline-delimited file where every line matches this schema. Append-only — never edited or reordered. Reclassification produces a NEW event of type 'reclassification', it does not mutate a prior event.",
  "type": "object",
  "required": ["seq", "ts", "type", "source_skill", "data"],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing sequence number. The writer helper reserves the next seq before appending."
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime of the event itself (not the write time)."
    },
    "type": {
      "type": "string",
      "enum": [
        "meeting",
        "decision",
        "decision_resolved",
        "decision_superseded",
        "commitment",
        "commitment_resolved",
        "sent_reconcile",
        "brief_state",
        "brief_meta",
        "gate_ran",
        "apply_choices_applied",
        "commitment_updated",
        "commitment_reclassified",
        "commitment_reopened",
        "commitment_reassigned",
        "commitment_partial_received",
        "commitment_observed",
        "commitment_review_proposed",
        "commitment_review_dismissed",
        "commitment_to_discuss",
        "reminder",
        "reminder_updated",
        "reminder_cleared",
        "thread_resolved",
        "interaction",
        "outreach_sent",
        "draft_created",
        "status_change",
        "scope_change",
        "intel_logged",
        "briefing",
        "audit_run",
        "onboarding_step",
        "onboarding_checkpoint",
        "reclassification",
        "classification_review",
        "pattern_break_detected",
        "tier_change",
        "org_proposed",
        "meeting_processed",
        "chat_dismissal",
        "chat_dismissal_cleared",
        "chat_suppressed",
        "choices_applied",
        "dont_forget_feedback",
        "pack_run",
        "connector_read",
        "schedule_created",
        "backfill_chunk_scheduled",
        "plugin_install",
        "plugin_update",
        "plugin_update_deferred",
        "plugin_update_remediation",
        "workspace_migration_applied",
        "workspace_migration_skipped",
        "workspace_setting_changed",
        "brain_name_captured",
        "brain_name_declined",
        "artifact_installed",
        "artifact_install_failed",
        "file_filed",
        "bug_received",
        "email_drafted",
        "email_sent",
        "memo_drafted",
        "one_pager_drafted",
        "automation_opportunity_surfaced",
        "automation_scaffolded",
        "automation_deployed",
        "search_performed",
        "meeting_scheduled",
        "contract_reviewed",
        "decision_reaffirmed",
        "decision_memo_drafted",
        "thread_resurrected",
        "intro_made",
        "intro_followup_check",
        "intro_landed",
        "intro_didnt_land",
        "board_pack_assembled",
        "followup_pack_drafted",
        "person_created",
        "person_updated",
        "person_merged",
        "person_repaired",
        "person_proposal",
        "person_update_proposal",
        "person_proposal_resolved",
        "person_added",
        "person_pending_review",
        "org_created",
        "org_updated",
        "org_repaired",
        "engagement_created",
        "engagement_updated",
        "thread_created",
        "thread_updated",
        "thread_repaired",
        "weekly_audit_run",
        "bug_reported",
        "levelup_session",
        "onboarding_setup_widget_emitted",
        "operator_report_generated",
        "value_receipt_generated",
        "project_proposed",
        "project_proposal",
        "weekly_recap_run",
        "decision_revisit_scheduled",
        "dont_forget_run",
        "dont_forget_snooze",
        "dont_forget_dormant_proposal",
        "dont_forget_dormant_proposal_declined",
        "org_proposal",
        "org_proposal_declined",
        "tier_validated",
        "scheduled_task_failure",
        "pending_review_dismissed",
        "meeting_skipped",
        "cracks_watch_feedback",
        "commitment_superseded",
        "corruption_recovery",
        "contact_email_captured",
        "email_outcome",
        "voice_block_updated",
        "voice_calibration_review",
        "dormancy_signal",
        "relationship_move_suggested",
        "coach_session",
        "m1_backfill_started",
        "m1_backfill_complete",
        "m1_training_prompt_shown",
        "m1_training_prompt_fired",
        "m1_voice_proof_shown",
        "wrapper_source_seq_backfill",
        "skill_first_run_configured",
        "skill_reconfigured",
        "project_stalled_flagged",
        "cleanup_run",
        "substrate_backfill",
        "shard_rotated",
        "schedule_config_changed",
        "person_disambiguation_resolved",
        "person_disambiguation_skipped",
        "bug_self_fixed",
        "project_loaded_deep",
        "pulse_live_check_overrode",
        "person_record_update",
        "person_record_update_rejected",
        "degraded_baseline",
        "brief_save_failed",
        "release_manifest_parse_failed",
        "release_detector_import_failed",
        "release_detector_raised",
        "release_detector_malformed_result",
        "release_action_import_failed",
        "release_action_raised",
        "release_action_failed",
        "release_action_failed_fallback",
        "person_enriched",
        "board_convened",
        "advisor_profile_exported",
        "advisor_profile_imported",
        "advisor_profile_modeled",
        "skill_customization_added",
        "skill_customization_removed",
        "skill_customization_updated",
        "skill_customization_reset",
        "skill_customization_review",
        "onboarding_seed_ingested",
        "schedule_config_healed",
        "schedule_parity_checked",
        "schedule_add_proposed",
        "late_fire",
        "pulse_run",
        "triage_feedback",
        "prep_feedback",
        "prep_brief",
        "sender_priority_proposal",
        "surface_preference_proposal",
        "confidence_override_proposal",
        "chase_policy_proposal",
        "commitment_noise_proposal",
        "prep_weight_proposal",
        "extraction_hint_proposal",
        "session_sweep_run",
        "session_backfill_run",
        "note",
        "other"
      ]
    },
    "source_skill": {
      "type": "string",
      "description": "Name of the skill that recorded this event (e.g., 'meeting-notes', 'workspace-manager')."
    },
    "primary_thread_id": {
      "type": ["string", "null"],
      "pattern": "^project_[0-9]{3,}$",
      "description": "The single thread that owns this event (its SESSION_NOTES append lives here). Null for workspace-level events."
    },
    "related_thread_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^project_[0-9]{3,}$"
      },
      "description": "Other threads touched by this event. Render as cross-ref entries in those threads' views. Does not own the SESSION_NOTES append."
    },
    "cross_ref_reason": {
      "type": "object",
      "description": "Map of related_thread_id → short human string explaining the link (e.g., 'vendor mentioned in passing'). Keys must exist in related_thread_ids.",
      "additionalProperties": { "type": "string" }
    },
    "classification_confidence": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Classifier's self-reported confidence in the primary_thread_id assignment. >=0.75 auto, 0.40-0.75 provisional (surfaced in weekly review), <0.40 low-confidence (flagged in weekly review). Null for events with no meaningful classification (e.g., audit_run, briefing)."
    },
    "project_id": {
      "type": ["string", "null"],
      "description": "DEPRECATED. Use primary_thread_id. Retained for backward compatibility; readers should fall back to this if primary_thread_id is missing."
    },
    "person_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "People involved in this event, canonical ids."
    },
    "org_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Orgs referenced by this event (useful for cross-org rollup views)."
    },
    "source_ref_hash": {
      "type": ["string", "null"],
      "description": "sha256 hash of the source artifact (email message-id, Slack permalink, calendar event id, etc.). Used for passive-capture dedup per shared/PASSIVE_CAPTURE.md."
    },
    "supersedes_seq": {
      "type": ["integer", "null"],
      "description": "If this event corrects or overrides an earlier event, its seq number. Reclassification events set this."
    },
    "data": {
      "type": "object",
      "description": "Type-specific payload. Examples documented in references/DATA_CONTRACT.md. For 'reclassification' events: {old_primary_thread_id, new_primary_thread_id, old_related_thread_ids, new_related_thread_ids, reason}. For 'classification_review' events: {reviewed_event_seqs[], confirmed_count, changed_count, skipped_count}. For 'outreach_sent' events (v2.10.7+): {thread_id, recipient_id, subject, via} where `via` is one of `\"zapier\" | \"gmail_mcp_threaded\" | \"gmail_mcp_standalone\"` indicating which send path was used (Zapier-threaded preferred per EMAIL_DRAFT_PROTOCOL.md §3c, native Gmail threaded fallback per §3a, standalone last resort). Useful for weekly-audit visibility into send-path mix."
    }
  }
}
